[sub_resource type="GDScript" id="GDScript_4qkwh"]
script/source = "extends Node3D

# --- ENLACES JERÁRQUICOS ---
@export var antena_principal : Node # Aquí arrastraremos la Antena_Principal
@export var limite_ancho_banda : float = 50.0 # Límite máximo para ESTE router individual

var ancho_banda_disponible : float = 50.0
var usuarios_conectados : int = 0

func _process(delta: float) -> void:
	usuarios_conectados = 0
	
	# Contamos cuántos estudiantes/NPCs están enganchados a este router específico
	var todos_usuarios = get_tree().get_nodes_in_group(\"usuarios_red\")
	for usuario in todos_usuarios:
		if \"router_conectado\" in usuario and usuario.router_conectado == self:
			usuarios_conectados += 1
			
	# --- CÁLCULO DE AFECTACIÓN EN CASCADA ---
	var proporcion_activa = 1.0 # 1.0 significa que la señal global está al 100%
	
	if is_instance_valid(antena_principal):
		var internet_global = antena_principal.obtener_ancho_banda_global()
		var contrato_global = antena_principal.ancho_banda
		
		# Si el internet global cae (ej. de 300 Mbps a 150 Mbps), la proporción será 0.5
		if contrato_global > 0:
			proporcion_activa = internet_global / contrato_global
			
	# El router calcula su ancho de banda real actual basándose en la salud de la antena
	var ancho_banda_real_router = limite_ancho_banda * proporcion_activa

	# --- REPARTICIÓN EQUITATIVA (Saturación local) ---
	if usuarios_conectados > 0:
		ancho_banda_disponible = ancho_banda_real_router / float(usuarios_conectados)
	else:
		ancho_banda_disponible = ancho_banda_real_router
"

